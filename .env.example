# 复制为 .env 后填写真实值： cp .env.example .env

# 服务间内部调用共享密钥（所有云端服务必须一致）
INTERNAL_SECRET=change-me-internal-secret

# JWT 签名密钥（api-server）
JWT_SECRET=change-me-jwt-secret

# 老虎私钥应用层加密密钥（Fernet）。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# PostgreSQL
POSTGRES_USER=sigtrades
POSTGRES_PASSWORD=sigtrades
POSTGRES_DB=sigtrades

# 运行环境：production 时会强制校验关键密钥（JWT_SECRET/INTERNAL_SECRET/ADMIN_TOKEN/FERNET_KEY 等），
# 仍为默认/空值则拒绝启动。开发环境填 development。
APP_ENV=development

# 幂等在飞窗口（秒）：ROUTING 记录在窗口内视为重复，防回报到达前二次下单
IDEM_IN_FLIGHT_SEC=300

# 启动时写入 demo 用户（demo@sigtrades.app / demo1234）；生产建议 false
SEED_DEMO=true

# Discord bot（可选）
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_BOT_PERMISSIONS=68608
# Bot OAuth 回调（需在 Discord Developer Portal 注册 redirect URI）
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/config/discord/callback
SCHWAB_OAUTH_REDIRECT_URI=https://127.0.0.1

# Telegram bot（可选；long-polling 或 webhook 二选一）
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# webhook 模式（启动时自动 setWebhook）
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=http://localhost:8082/ingest/telegram/webhook


# OpenAI / OpenAI-compat（AI 解析，可选；与 sunny-quant 相同变量名）
OPENAI_API_KEY=
AI_CLIENT_MODE=openai
AI_API_KEY=
# packyapi：gpt-5.5 不支持 chat completions，解析请用 gpt-5.4
AI_MODEL=gpt-5.4
AI_OPENAI_COMPAT_BASE=https://www.packyapi.com
AI_MAX_TOKENS=2000
AI_TIMEOUT=30

# 前端 URL（邮件 / Discord 回调跳转）
FRONTEND_URL=http://127.0.0.1:5173
# Relay Agent 浏览器登录后连接的 WS（Docker/Caddy 本地默认如下）
# Agent 登录/连接时写入客户端的 Relay 地址（生产务必用 wss://agent.sigtrades.com；本地 Docker 可改 ws://127.0.0.1:8081/agent/ws）
RELAY_AGENT_WS_URL=wss://agent.sigtrades.com/agent/ws

# 用户端 Dashboard 展示的 ingest Webhook 基址（本地 Docker 默认 8082；生产用 https://stapi.sigtrades.com，且 nginx 需把 /ingest/ 反代到 :8082）
INGEST_PUBLIC_URL=http://localhost:8082

# Google OAuth（web 端 VITE_GOOGLE_CLIENT_ID 需与此一致）
GOOGLE_CLIENT_ID=

# 是否强制邮箱验证后才能使用写操作（生产建议 true）
REQUIRE_EMAIL_VERIFICATION=true

# SMTP（留空则 dev 模式只打日志；生产推荐 Resend）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sigtrades.app
SMTP_USE_TLS=true

# Resend（推荐：验证/重置/订阅邮件）
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=sigtrades
# Resend 入站 Webhook（Resend Dashboard → Webhooks → email.received）
RESEND_WEBHOOK_SECRET=
# 本地 dev 跳过 Svix 验签（仅开发环境）
ALLOW_INSECURE_INBOUND_WEBHOOK=false
# Webhook URL: https://your-api/mail/webhook/received

# GeoIP（可选，用于后台用户国家；需先 make download-geoip）
# Docker 内默认 /app/data/geoip/...；本地非 Docker 可改为 data/geoip/...
GEOIP2_CITY_DB_PATH=/app/data/geoip/GeoLite2-City.mmdb
GEOIP2_COUNTRY_DB_PATH=/app/data/geoip/GeoLite2-Country.mmdb
# MaxMind 下载: make download-geoip MAXMIND_LICENSE_KEY=...

# 推送（可选）
NOTIFY_PUSH_WEBHOOK=
# FCM HTTP v1（Firebase Service Account JSON，替代已停用的 Legacy server key）
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
FCM_CREDENTIALS_PATH=
# Firebase Web 推送（公开配置，供 web 前端 / Service Worker）
FIREBASE_WEB_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=
FIREBASE_AUTH_DOMAIN=

# CORS（生产前端域名，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Agent 版本检查（relay-agent SIGTRADES_VERSION_CHECK_URL 指向 /public/agent-version）
AGENT_LATEST_VERSION=0.1.0
# 打包后填入（make build-agent 会输出）；示例：
# AGENT_DOWNLOAD_URL=http://localhost:8080/releases/sigtrades-agent-macos.zip
AGENT_DOWNLOAD_URL=
AGENT_SHA256=
# 后台「加载本地包」拼下载 URL 用（本地 Docker 默认；生产设为 https://stapi.sigtrades.com/releases）
AGENT_RELEASES_PUBLIC_BASE=http://localhost:8080/releases
# Windows 可选独立配置（未设则 macOS 版本号作回退，下载地址为空）
# AGENT_WINDOWS_LATEST_VERSION=0.1.0
# AGENT_WINDOWS_DOWNLOAD_URL=
# AGENT_WINDOWS_SHA256=

# Admin 后台（静态 token + 用户名密码登录；生产请自行生成强密码）
ADMIN_USERNAME=sigtrades_admin
ADMIN_PASSWORD=请设置强密码
ADMIN_TOKEN=at_请设置独立token
OPERATIONS_USERNAME=sigtrades_ops
OPERATIONS_PASSWORD=请设置强密码
OPERATIONS_TOKEN=at_请设置独立token

# Docker 构建 pip 镜像（访问 files.pythonhosted.org 超时时启用）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
